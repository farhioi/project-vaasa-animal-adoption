 Lisätty pinkki teema ja yhtenäinen väritys koko sovellukseen
:root {
  --bg: #ffeaf5;
  --bg-dark: #f9d7ec;
  --card: #ffffff;
  --text: #2d1b2f;
  --muted: #8b6b8e;
  --accent: #ec4899;
  --accent-soft: #f9a8d4;
  --border: #fbcfe8;
  --shadow: 0 18px 40px rgba(236, 72, 153, 0.22);
}

body {
  background: radial-gradient(circle at top, #ffffff 0, var(--bg) 50%, var(--bg-dark) 100%);
}
